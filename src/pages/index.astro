3-4 1-2 1-3q4-1 4-5 0-3 3-7l3-7 1-3 5-11 2-4 2-4 4-9q3-7 2-12 0-4 2-7 3-4 0-6l-1-6-2-5-2-5-1-9q0-6-2-6l-4-2q-4-4-13 2M95 591l-9 7c-4 3 1 11 7 12q2 2 7-3c4-4 4-4 4-10q0-6-2-6l-3-1q-2-1-4 1m98 127q-7 9-3 14l1 3 1 3 1 3q-1 4 2 4l7 7 8 4 5-2c4-1 10-5 10-6l2-3q5-4 0-10l-3-5-2-3-4-2-3-2q-6-1-7-5 0-4-4-1h-2q-5-3-9 1m-56 3-7 2q-2 0-5 7l-3 6 2 5c4 7 12 15 17 16 13 3 27-1 32-11q3-8-1-9l-1-2q-1-3-8-7l-9-4q-9-4-17-3m111 4c-8 6-8 6-8 10 1 6 7 17 9 18l4 3c4 3 17 4 22 1q12-5 11-12l-1-5-2-2-6-7c-8-8-8-8-12-7h-7q-4-4-10 1m66 3-9 10v4q-2 3 1 4l1 2 2 4 2 5c0 3 6 7 8 5l1 1c3 5 16 7 20 3l6-1q4-1 7-6 6-5 1-9l-2-4-2-4-5-4-5-3-4-2-2-1-5-2q-8-4-15-2';
function renderZnacka(css = '') {
  return `<svg class="${css}" viewBox="0 0 620 810" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="${znackaD}"/></svg>`;
}
// Ručne kreslené SVG ilustrácie pre produktové karty (žiadne externé obrázky).
function renderIlustracia(typ: string): string {
  const jar = (telo: string, lid: string) => `
    <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
      <rect x="40" y="14" width="40" height="10" rx="3" fill="${lid}"/>
      <rect x="44" y="22" width="32" height="7" rx="2" fill="#fff" opacity="0.55"/>
      <path d="M34 34 q26 -6 52 0 v54 a8 8 0 0 1 -8 8 H42 a8 8 0 0 1 -8 -8 z" fill="${telo}"/>
      <rect x="46" y="56" width="28" height="22" rx="4" fill="#FBF3E2" opacity="0.92"/>
      <path d="M50 62 h20 M50 68 h20 M50 74 h14" stroke="${lid}" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
      <ellipse cx="46" cy="44" rx="5" ry="14" fill="#fff" opacity="0.22"/>
    </svg>`;
  switch (typ) {
    case 'med':
      return jar('#E0A93C', '#7A3B0E');
    case 'med-tmavy':
      return jar('#9A6722', '#3D2410');
    case 'vajicka':
      return `
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="60" cy="92" rx="44" ry="9" fill="#7A3B0E" opacity="0.12"/>
          <g>
            <ellipse cx="42" cy="62" rx="20" ry="26" fill="#fdfaf0"/>
            <ellipse cx="36" cy="54" rx="6" ry="9" fill="#fff" opacity="0.7"/>
          </g>
          <g>
            <ellipse cx="74" cy="66" rx="21" ry="27" fill="#F3E3C0"/>
            <ellipse cx="68" cy="56" rx="6" ry="9" fill="#fff" opacity="0.6"/>
          </g>
          <ellipse cx="59" cy="48" rx="14" ry="18" fill="#fffdf6"/>
          <circle cx="59" cy="48" r="7" fill="#E0A93C"/>
        </svg>`;
    case 'sviecka':
      return `
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="60" cy="100" rx="30" ry="7" fill="#7A3B0E" opacity="0.12"/>
          <rect x="44" y="38" width="32" height="58" rx="6" fill="#E4C98F"/>
          <rect x="49" y="38" width="6" height="58" fill="#fff" opacity="0.3"/>
          <ellipse cx="60" cy="38" rx="16" ry="5" fill="#D8B871"/>
          <rect x="58" y="22" width="4" height="12" rx="2" fill="#5A3A14"/>
          <path d="M60 6 q9 9 0 18 q-9 -9 0 -18z" fill="#E9A23B"/>
          <path d="M60 11 q5 6 0 12 q-5 -6 0 -12z" fill="#F6D77A"/>
        </svg>`;
    case 'pel':
      return `
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="60" cy="104" rx="30" ry="6" fill="#7A3B0E" opacity="0.12"/>
          <rect x="40" y="16" width="40" height="9" rx="3" fill="#7A3B0E"/>
          <rect x="44" y="23" width="32" height="6" rx="2" fill="#fff" opacity="0.5"/>
          <path d="M36 38 q24 -6 48 0 v50 a8 8 0 0 1 -8 8 H44 a8 8 0 0 1 -8 -8 z" fill="#E9C46A" opacity="0.45"/>
          <g>
            <circle cx="48" cy="72" r="4" fill="#E0901E"/>
            <circle cx="57" cy="68" r="4.2" fill="#E8B24A"/>
            <circle cx="66" cy="72" r="4" fill="#C77A12"/>
            <circle cx="74" cy="70" r="3.5" fill="#E0901E"/>
            <circle cx="44" cy="81" r="3.6" fill="#E8B24A"/>
            <circle cx="53" cy="83" r="4" fill="#C77A12"/>
            <circle cx="62" cy="81" r="4" fill="#E0901E"/>
            <circle cx="71" cy="82" r="3.8" fill="#E8B24A"/>
            <circle cx="48" cy="91" r="3.5" fill="#C77A12"/>
            <circle cx="57" cy="92" r="3.8" fill="#E0901E"/>
            <circle cx="66" cy="91" r="3.6" fill="#E8B24A"/>
          </g>
          <ellipse cx="46" cy="48" rx="5" ry="13" fill="#fff" opacity="0.25"/>
        </svg>`;
    case 'sliepka':
      return `
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="58" cy="108" rx="36" ry="6" fill="#7A3B0E" opacity="0.12"/>
          <path d="M24 56 q-14 4 -16 18 q14 -1 24 -10 z" fill="#E0A93C"/>
          <ellipse cx="54" cy="70" rx="36" ry="26" fill="#fdfaf2"/>
          <path d="M40 62 q16 -8 32 0 q-14 12 -34 7 z" fill="#F1E2BC"/>
          <circle cx="84" cy="46" r="15" fill="#fdfaf2"/>
          <path d="M84 31 q5 -9 11 -3 q-1 7 -9 8 z" fill="#C0392B"/>
          <path d="M82 60 q1 6 7 6 q2 -5 -2 -9 z" fill="#C0392B"/>
          <path d="M98 46 l13 4 -12 5 z" fill="#E58E26"/>
          <circle cx="90" cy="44" r="2.6" fill="#2A1E12"/>
          <path d="M48 95 l-3 13 M60 95 l3 13" stroke="#E58E26" stroke-width="3.5" fill="none" stroke-linecap="round"/>
        </svg>`;
    case 'kohut':
      return `
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="58" cy="108" rx="36" ry="6" fill="#7A3B0E" opacity="0.12"/>
          <path d="M20 72 q-12 -34 14 -50 q4 6 -2 16 q14 -14 24 -10 q-6 8 -14 14 q10 -4 16 2 q-18 16 -38 34 z" fill="#3D4A2A"/>
          <path d="M22 70 q-6 -26 16 -40 q2 8 -4 16 q10 -8 16 -4 q-12 14 -28 32 z" fill="#4E5B3A"/>
          <ellipse cx="56" cy="72" rx="32" ry="25" fill="#B5701F"/>
          <ellipse cx="56" cy="78" rx="30" ry="18" fill="#9A5A14"/>
          <path d="M44 66 q16 -8 30 2 q-14 12 -32 7 z" fill="#D88A2B"/>
          <circle cx="84" cy="44" r="14" fill="#C77A1A"/>
          <path d="M74 52 q8 -4 18 0 q-6 10 -18 6 z" fill="#9A5A14"/>
          <path d="M80 30 q4 -10 9 -5 q3 -8 8 -2 q4 -6 7 2 q3 8 -6 12 q-10 4 -18 -1 z" fill="#C0392B"/>
          <path d="M82 58 q1 9 8 9 q2 -7 -2 -12 z" fill="#C0392B"/>
          <path d="M98 44 l14 4 -13 6 z" fill="#E58E26"/>
          <circle cx="90" cy="42" r="2.8" fill="#2A1E12"/>
          <path d="M50 96 l-3 13 M62 96 l3 13" stroke="#E58E26" stroke-width="3.8" fill="none" stroke-linecap="round"/>
        </svg>`;
    case 'les':
      return `
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="60" cy="106" rx="38" ry="6" fill="#7A3B0E" opacity="0.12"/>
          <path d="M18 102 q30 -10 50 0 q20 -8 34 0" fill="none" stroke="#8a5a2b" stroke-width="3" stroke-linecap="round" opacity="0.5"/>
          <rect x="30" y="78" width="7" height="24" rx="3" fill="#8a5a2b"/>
          <path d="M33 22 l20 34 h-12 l16 26 h-48 l16 -26 h-12 z" fill="#4E5B3A"/>
          <path d="M33 22 l20 34 h-12 l16 26 h-24 z" fill="#3D4A2A"/>
          <rect x="80" y="82" width="6" height="20" rx="3" fill="#8a5a2b"/>
          <circle cx="83" cy="62" r="21" fill="#6E7C4F"/>
          <circle cx="72" cy="54" r="10" fill="#7d8c5c"/>
          <circle cx="93" cy="50" r="8" fill="#5E6C41"/>
          <circle cx="20" cy="34" r="7" fill="#E9C46A" opacity="0.9"/>
        </svg>`;
    case 'meditacia':
      return `
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="60" cy="106" rx="34" ry="6" fill="#7A3B0E" opacity="0.12"/>
          <path d="M60 17 a43 43 0 1 0 14 2.4" fill="none" stroke="#2A1E14" stroke-width="8" stroke-linecap="round" opacity="0.88"/>
          <circle cx="60" cy="60" r="5" fill="#C57E1E"/>
        </svg>`;
    case 'ule':
      return `
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="56" cy="106" rx="36" ry="6" fill="#7A3B0E" opacity="0.12"/>
          <path d="M28 100 q-2 -10 4 -12 h48 q6 2 4 12 z" fill="#C77A12"/>
          <path d="M30 88 q-4 -12 4 -14 h44 q8 2 4 14 z" fill="#E0A93C"/>
          <path d="M34 74 q-4 -12 4 -13 h36 q8 1 4 13 z" fill="#C77A12"/>
          <path d="M38 61 q-3 -10 4 -11 h28 q7 1 4 11 z" fill="#E0A93C"/>
          <path d="M44 50 q0 -14 12 -14 q12 0 12 14 z" fill="#C77A12"/>
          <path d="M50 100 v-8 a6 6 0 0 1 12 0 v8 z" fill="#5B3A12"/>
          <g transform="translate(92 40)">
            <ellipse cx="0" cy="0" rx="8" ry="5.5" fill="#E9C46A"/>
            <path d="M-3.5 -4.5 v9 M1.5 -5 v10" stroke="#2A1E12" stroke-width="1.8"/>
            <ellipse cx="-5" cy="-5" rx="5" ry="3" fill="#fff" opacity="0.7"/>
          </g>
          <path d="M84 52 q-6 8 -14 10" fill="none" stroke="#2A1E12" stroke-width="1.6" stroke-dasharray="1 5" stroke-linecap="round" opacity="0.55"/>
        </svg>`;
    default:
      return '';
  }
}
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{seo.titul}</title>
    {!seo.indexovat && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={seo.popis} />
    <link rel="canonical" href={seo.url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.titul} />
    <meta property="og:description" content={seo.popis} />
    <meta property="og:url" content={seo.url} />
    <meta property="og:image" content={`${seo.url}og.png`} />
    <meta property="og:locale" content="sk_SK" />
    <script type="application/ld+json" set:html={JSON.stringify(ldJson)} />
    <link rel="preload" as="image" href="/foto/dom-pod-lesom.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- ── Navigácia ────────────────────────────────────────────────── -->
    <header class="nav" id="top">
      <div class="container nav__inner">
        <a class="nav__brand" href="#top" aria-label="Domov">
          <Fragment set:html={renderZnacka('nav__mark')} />
          <span>Na <em>Lúke</em></span>
        </a>
        <button
          class="nav__toggle"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <span></span><span></span><span></span>
        </button>
        <nav class="nav__links" id="nav-menu" aria-label="Hlavné menu">
          <a href="#program">Program</a>
          <a href="#o-nas">O Otovi</a>
          <a href="#med">Med</a>
          <a href="#rezervacia" class="nav__cta">Rezervovať</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ── Hero — skutočná fotografia miesta ─────────────────────── -->
      <section class="hero">
        <div class="container hero__inner">
          <div class="hero__text reveal">
            <p class="eyebrow">Horný Gemer · Soboty a nedele · Od {farma.zalozene}</p>
            <h1 class="hero__title">
              Ticho, včely<br />a&nbsp;<span class="hero__accent">les.</span>
            </h1>
            <p class="hero__lead">
              Deň na lúke a v lese: pomalá prechádzka starým lesom, meditácia
              pod holým nebom a oddych pri úľoch. Domov si odnesiete pokoj —
              a možno aj pohár medu.
            </p>
            <div class="hero__actions">
              <a href="#program" class="btn">Ako vyzerá deň</a>
              <a href="#rezervacia" class="btn btn--ghost">Rezervovať termín</a>
            </div>
          </div>

        </div>
        <a href="#program" class="hero__scroll" aria-label="Prejsť na program">
          <span>Vojdite</span>
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path d="M3 6l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </section>

      <!-- ── Program: Deň na lúke a v lese ─────────────────────────── -->
      <section class="section" id="program">
        <div class="container">
          <header class="section__head reveal">
            <p class="eyebrow">Program</p>
            <h2 class="section__title">{den.nazov}</h2>
            <p class="section__sub">
              Poldenný program v malej skupine — bez zhonu, bez mobilov, bez
              výkonov. Tri veci, ktoré spolu tvoria jeden pomalý deň.
            </p>
          </header>

          <div class="products">
            {den.zazitky.map((z) => (
              <article class="card reveal">
                <div class={`card__art card__art--${z.ilustracia}`}>
                  <Fragment set:html={renderIlustracia(z.ilustracia)} />
                </div>
                <div class="card__body">
                  <span class="card__tag">{z.tag}</span>
                  <h3 class="card__title">{z.nazov}</h3>
                  <p class="card__text">{z.popis}</p>
                </div>
              </article>
            ))}
          </div>

          <ol class="steps reveal">
            {den.priebeh.map((k, i) => (
              <li class="step">
                <span class="step__num">{i + 1}</span>
                <h3 class="step__title">{k.nazov}</h3>
                <p class="step__text">{k.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- ── O Otovi ──────────────────────────────────────────────── -->
      <section class="story" id="o-nas">
        <div class="story__texture" aria-hidden="true"></div>
        <div class="container story__inner">
          <div class="story__text reveal">
            <p class="eyebrow eyebrow--light">O Otovi</p>
            <h2 class="story__title">
              Kým som postavil prvý úľ, prešiel som pešo pol sveta.
            </h2>
            <p>
              Pred vyše dvadsiatimi rokmi som vyšiel z Gemera a šiel som pešo —
              cez krajiny a hranice — až do Kórey. Šesť rokov som tam žil ako
              budhistický mních. Naučilo ma to jednu vec: keď sa neponáhľaš,
              všetko dôležité príde samo.
            </p>
            <p>
              Dnes žijem so ženou a synom na lúke pod lesom — a so včelami.
              Deň, ktorý u nás strávite, je kus tejto cesty: ticho, pomalá
              chôdza a úcta k niečomu väčšiemu, ako si ty sám.
            </p>
            <ul class="story__facts">
              <li><strong>Pešo</strong><span>z Gemera do Kórey</span></li>
              <li><strong>6 rokov</strong><span>budhistickým mníchom</span></li>
              <li><strong>Od {farma.zalozene}</strong><span>so včelami na lúke</span></li>
            </ul>
          </div>
          <div class="story__art reveal">
            <div class="foto foto--portrait">
              <span>Fotografia Ota<br /><small>doplníme čoskoro</small></span>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Les za lúkou (Otova fotografia) ──────────────────────── -->
      <section class="fotopas" aria-label="Les za lúkou">
        <figure class="reveal">
          <img
            src="/foto/les-za-lukou.jpg"
            alt="Starý ihličnatý les vo večernom svetle"
            width="1800"
            height="905"
            loading="lazy"
          />
          <figcaption>Starý les za lúkou — tadiaľto vedie prechádzka.</figcaption>
        </figure>
      </section>

      <!-- ── Rezervácia ───────────────────────────────────────────── -->
      <section class="section order" id="rezervacia">
        <div class="container">
          <header class="section__head reveal">
            <p class="eyebrow">Rezervácia</p>
            <h2 class="section__title">Dohodnite si svoj deň</h2>
            <p class="section__sub">
              Žiadny rezervačný systém — jeden e-mail stačí. Chodíme v malých
              skupinách, preto je termín vždy len váš.
            </p>
          </header>

          <div class="zones reveal">
            {den.info.map((z) => (
              <article class="zone">
                <span class="zone__kod">{z.kod}</span>
                <h3 class="zone__nazov">{z.nazov}</h3>
                <p class="zone__text">{z.text}</p>
                <p class="zone__cena">{z.cena}</p>
              </article>
            ))}
          </div>

          <ol class="steps reveal">
            {[
              { nazov: 'Napíšte', text: 'Pošlite e-mail: koľko vás je, aký víkend by vám sedel a či má niekto alergiu na včelie bodnutie.' },
              { nazov: 'Dohodneme termín', text: 'Ozveme sa, doladíme deň a pošleme presné miesto stretnutia.' },
              { nazov: 'Prídete', text: 'Pevné topánky, pokoj v duši. Všetko ostatné je na nás.' },
            ].map((k, i) => (
              <li class="step">
                <span class="step__num">{i + 1}</span>
                <h3 class="step__title">{k.nazov}</h3>
                <p class="step__text">{k.text}</p>
              </li>
            ))}
          </ol>

          <aside class="notice reveal">
            <h3 class="notice__title">Dobré vedieť</h3>
            <ul>
              {den.dobreVediet.map((r) => <li>{r}</li>)}
            </ul>
          </aside>

          <div class="order__cta reveal">
            <div class="order__pay">
              <span class="contact__label">Platba</span>
              <p class="order__paytext">
                V hotovosti na mieste — <strong>10 € dospelý</strong>, 5 € dieťa
                od 10 do 15 rokov.
              </p>
              <p class="order__paynote">Žiadna záloha vopred. Ak vám do termínu niečo príde, jednoducho napíšte.</p>
            </div>
            <div class="order__actions">
              <a
                href={`mailto:${kontakt.email}?subject=${encodeURIComponent('Rezervácia — Deň na lúke a v lese')}`}
                class="btn"
              >Rezervovať e-mailom</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Miestnosť ticha (Otova fotografia) ───────────────────── -->
      <section class="fotopas" aria-label="Otova miestnosť ticha">
        <figure class="reveal">
          <img
            src="/foto/miestnost-ticha.jpg"
            alt="Drevená miestnosť s oltárom, obrazom Budhu a ručne maľovanými panelmi s kvetmi"
            width="1800"
            height="1457"
            loading="lazy"
          />
          <figcaption>Otova miestnosť ticha.</figcaption>
        </figure>
      </section>

      <!-- ── Med ──────────────────────────────────────────────────── -->
      <section class="section" id="med">
        <div class="container">
          <header class="section__head reveal">
            <p class="eyebrow">Z našej lúky</p>
            <h2 class="section__title">Med si odnesiete domov</h2>
            <p class="section__sub">
              Na konci dňa ochutnáte med rovno z našich úľov — a čo vám
              zachutí, kúpite na mieste. Med a peľ posielame aj poštou cez
              Packetu, po Slovensku a do Česka.
            </p>
          </header>

          <div class="products">
            {produkty.map((p) => (
              <article class="card reveal">
                <div class={`card__art card__art--${p.ilustracia}`}>
                  <Fragment set:html={renderIlustracia(p.ilustracia)} />
                </div>
                <div class="card__body">
                  <span class="card__tag">{p.tag}</span>
                  <h3 class="card__title">{p.nazov}</h3>
                  <p class="card__text">{p.popis}</p>
                  <div class="card__prices">
                    {p.ceny.map((c) => (
                      <p class="card__price">
                        <span class="card__price-sum">{c.suma}</span>
                        <span class="card__price-za">{c.za}</span>
                      </p>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="order__cta reveal">
            <div class="order__pay">
              <span class="contact__label">Objednávka poštou</span>
              <p class="order__paytext">
                Napíšte, čo a koľko — ozveme sa s poštovným podľa Packety.
                Platba prevodom alebo na dobierku.
              </p>
              {objednavka.iban ? (
                <div class="order__bank">
                  <div>
                    <p class="order__paytext">Bankový prevod — IBAN <strong>{objednavka.iban}</strong></p>
                    {objednavka.majitelUctu ? (
                      <p class="order__paynote">Účet: {objednavka.majitelUctu}</p>
                    ) : null}
                    <p class="order__paynote">
                      Alebo naskenujte QR kód v aplikácii svojej banky — údaje sa
                      predvyplnia samy. Sumu doplňte podľa potvrdzujúceho e-mailu.
                    </p>
                  </div>
                  <div class="order__qr" set:html={qrPlatbaSvg} />
                </div>
              ) : (
                <p class="order__paynote">Platobné údaje pošleme v potvrdzujúcom e-maile.</p>
              )}
            </div>
            <div class="order__actions">
              <a
                href={`mailto:${kontakt.email}?subject=${encodeURIComponent('Objednávka medu — Na Lúke')}`}
                class="btn"
              >Objednať e-mailom</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Kontakt ──────────────────────────────────────────────── -->
      <section class="section contact" id="kontakt">
        <div class="container">
          <header class="section__head reveal">
            <p class="eyebrow">Ozvite sa</p>
            <h2 class="section__title">Napíšte nám</h2>
            <p class="section__sub">
              Najlepšie je napísať vopred — ozveme sa, dohodneme.
            </p>
          </header>

          <div class="contact__grid reveal">
            <a class="contact__card contact__card--primary" href={`mailto:${kontakt.email}`}>
              <span class="contact__label">Napíšte nám</span>
              <span class="contact__value">{kontakt.email}</span>
              <span class="contact__hint">Odpovedáme zvyčajne do dňa–dvoch →</span>
            </a>
            <div class="contact__card">
              <span class="contact__label">Kde sme</span>
              <span class="contact__value">
                {kontakt.adresa.map((r, i) => (
                  <>{r}{i < kontakt.adresa.length - 1 ? <br /> : null}</>
                ))}
              </span>
              <span class="contact__hint">Presné miesto pošleme po potvrdení termínu</span>
            </div>
            <div class="contact__card contact__card--hours">
              <span class="contact__label">Termíny</span>
              <ul class="hours">
                {kontakt.hodiny.map(([d, h]) => (
                  <li><span>{d}</span><span>{h}</span></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ── Pätička ──────────────────────────────────────────────── -->
    <footer class="footer">
      <div class="container footer__inner">
        <div class="footer__znacka" set:html={renderZnacka('')} />
        <p class="footer__name">{farma.nazov}</p>
        <p class="footer__note">Vyrobené s láskou na vidieku · {kontakt.adresa[0]}</p>
        <p class="footer__copy">© {new Date().getFullYear()} {farma.nazov}</p>
      </div>
    </footer>

    <script>
      // Scroll-reveal — respektuje "prefers-reduced-motion"
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        items.forEach((el) => io.observe(el));
      }

      // Jemný tieň navigácie po odscrollovaní
      const nav = document.querySelector('.nav');
      const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Mobilné menu (hamburger)
      const toggle = nav?.querySelector('.nav__toggle');
      const setMenu = (open: boolean) => {
        nav?.classList.toggle('is-open', open);
        toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      toggle?.addEventListener('click', () =>
        setMenu(!nav?.classList.contains('is-open'))
      );
      // Zavrieť po kliknutí na položku alebo klávesou Esc
      nav?.querySelectorAll('.nav__links a').forEach((a) =>
        a.addEventListener('click', () => setMenu(false))
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });
    </script>
  </body>
</html>

